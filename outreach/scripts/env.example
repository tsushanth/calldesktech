# Outreach scripts environment (sensitive — do not commit)

# CallDeskTech API (required for sending SMS)
CALLDESK_API_KEY=cdk_live_...
CALLDESK_BASE_URL=https://calldesk.tech/api/v1

# Trial onboarding (required for trial-sms-onboarding.js)
# Get UUID from list_phone_numbers MCP tool
TRIAL_FROM_NUMBER_ID=...

# Supabase (required for tracking)
SUPABASE_URL=https://...supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Groq (optional — enables LLM classification of SMS replies)
# Without it, polling falls back to keyword regex matching
GROQ_API_KEY=gsk_...

# Call loop for AI callbacks (required for poll-warm-replies.js)
CALL_LOOP_URL=https://call-loop-poc.fly.dev
TEST_CALL_SECRET=
